# apiKey y appId: firebaseConfig de la app web (consola de Firebase)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=esmassiva-chat.firebaseapp.com
FIREBASE_DATABASE_URL=https://esmassiva-chat-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=esmassiva-chat
FIREBASE_APP_ID=

# mismo chat que app-comercio y la API
CHAT_ID=chat-demo-001

# emulador Android: 10.0.2.2 apunta al localhost del host
# simulador iOS: http://localhost:3000 · dispositivo físico: http://<ip-local>:3000
API_URL=http://10.0.2.2:3000
