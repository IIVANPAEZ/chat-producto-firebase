# Copiar a .env y completar con el firebaseConfig de la app web registrada en Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=esmassiva-chat.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://esmassiva-chat-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=esmassiva-chat
VITE_FIREBASE_APP_ID=

# Chat que abre el comercio (debe coincidir con el de app-cliente y CHAT_ID de la API)
VITE_CHAT_ID=chat-demo-001
