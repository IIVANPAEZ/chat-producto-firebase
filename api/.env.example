# Puerto HTTP de la API
PORT=3000

# Archivo donde se guardan los pedidos (relativo a la carpeta api/)
ORDERS_FILE_PATH=orders.json

# chatId compartido por las tres piezas. Si se define, la API rechaza pedidos de otro chat.
CHAT_ID=chat-demo-001

# Orígenes permitidos por CORS separados por coma, o * para todos
CORS_ORIGIN=*
